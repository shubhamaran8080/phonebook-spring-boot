# Database credentials used by the PostgreSQL container and the backend.
# Copy this file to `.env` and change the values before deploying.
# The values below are placeholders only - never commit real secrets.
POSTGRES_USER=phonebook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=phonebook_spring

# Secret key used to sign the JWT authentication tokens.
# Replace with a long random string, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# The backend reads JWT_SECRET_KEY (falling back to SECRET_KEY).
# If left empty, the backend generates an ephemeral key on each start
# (fine for demos, but users will have to log in again after a restart).
JWT_SECRET_KEY=

# Optional overrides for the Spring Boot datasource.
# By default the backend connects to jdbc:postgresql://localhost:5432/phonebook_spring
# with the POSTGRES_USER / POSTGRES_PASSWORD values above.
#SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/phonebook_spring
#SPRING_DATASOURCE_USERNAME=phonebook
#SPRING_DATASOURCE_PASSWORD=change-me
